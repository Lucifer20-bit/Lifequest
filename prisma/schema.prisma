generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  avatar         String            @default("architect")
  archetype      String            @default("Architect")
  level          Int               @default(1)
  xp             Int               @default(0)
  currentStreak  Int               @default(1)
  lastActiveDate String            @default("")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  goals          Goal[]
  quests         Quest[]
  achievements   UserAchievement[]
  xpHistory      XpHistory[]
}

model LifePillar {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String
  color       String
  description String

  goals       Goal[]
  quests      Quest[]
}

model Goal {
  id          String      @id @default(cuid())
  userId      String
  pillarId    String
  title       String
  description String?
  status      String      @default("ACTIVE")
  progress    Float       @default(0)
  targetDate  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillar      LifePillar  @relation(fields: [pillarId], references: [id])
  quests      Quest[]
}

model Quest {
  id               String      @id @default(cuid())
  userId           String
  goalId           String?
  pillarId         String
  title            String
  description      String
  difficulty       String      @default("MEDIUM")
  estimatedMinutes Int         @default(30)
  xpReward         Int         @default(120)
  skillTag         String      @default("General")
  status           String      @default("PENDING")
  isDaily          Boolean     @default(true)
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  pillar           LifePillar  @relation(fields: [pillarId], references: [id])
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String
  badgeIcon   String
  xpBonus     Int               @default(100)
  category    String            @default("GENERAL")

  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model XpHistory {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  source    String
  questId   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
